# ===== 服务基础 =====
# 监听端口
PORT=3000
# 监听地址，0.0.0.0 表示所有网卡
HOST=0.0.0.0
# 运行环境：production / development
NODE_ENV=production
# 允许的跨域来源，部署到域名后填实际地址
ALLOWED_ORIGIN=http://localhost:3000

# ===== 数据加密主密钥（必需）=====
# 用于加密身份证号、手机号等敏感字段。必须是 32 字节密钥的 hex 或 base64 表示。
# 生成方式：openssl rand -hex 32
# 缺失或长度不对时进程会拒绝启动（fail-fast，不会静默写入空值）。
ZONGCE_MASTER_KEY=

# ===== 默认初始密码 =====
# 管理员账号的初始密码；留空则使用内置默认值。
# 生产环境请务必设置，并在首次登录后立即修改。
DEFAULT_ADMIN_PASSWORD=
# 管理员二级审核密码的初始值；留空则使用内置默认值。
# 二级密码用于改判、导出等敏感操作，与登录密码分离。
DEFAULT_SECONDARY_PASSWORD=

# ===== 告警推送（可选）=====
# 企业微信机器人 webhook 地址，用于异常与健康告警；留空则不推送。
ZONGCE_ALERT_WEBHOOK=

# ===== Cloudflare R2 对象存储（可选）=====
# 四项全部填写时启用 R2，导出包上传到对象存储并返回预签名下载链接；
# 任一项留空则自动回退为本地 zip 模式（导出包存放在 export-jobs/ 目录）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
